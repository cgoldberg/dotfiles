"""Display all 256 ANSI colors with background and foreground samples."""


def print_color_palette():
    columns = 4
    for i in range(256):
        background = f"\033[48;5;{i}m\033[38;5;15m {i:03} \033[0m"
        foreground = f"\033[38;5;{i}m {i:03} \033[0m"
        print(f"{background} {foreground}", end="     ")
        if (i + 1) % columns == 0:
            print()


if __name__ == "__main__":
    print_color_palette()
