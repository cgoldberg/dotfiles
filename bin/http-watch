#!/usr/bin/env bash
#
# Copyright (c) 2026 Corey Goldberg (https://github.com/cgoldberg)
# License: MIT
#
# http-watch - wait for an HTTP 200 then throw a tiny victory party
#
# Requirements:
#   - bash
#   - curl
#   - pw-play (PipeWire)
#
# Usage:
#   ./http-watch <url> [poll_interval]
#
# Example:
#   ./http-watch https://example.com/health
#   ./http-watch https://example.com/health 5

set -u

POLL_INTERVAL="${2:-10}"
CELEBRATION_SECONDS=10
SOUND_URL="https://opengameart.org/sites/default/files/fanfare1.wav"

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    echo "Usage: $0 <url> [poll_interval]"
    echo "Example: $0 https://example.com/health"
    echo "Example: $0 https://example.com/health 5"
    exit 2
fi

URL="$1"
SOUND_FILE=$(mktemp --suffix=.wav)
PLAY_PID=""

cleanup() {
    trap - INT TERM EXIT
    if [ -n "${PLAY_PID}" ]; then
        kill "${PLAY_PID}" 2>/dev/null || true
    fi
    rm -f "${SOUND_FILE}"
}

handle_interrupt() {
    echo
    echo "Interrupted."
    cleanup
    exit 130
}

trap handle_interrupt INT TERM
trap cleanup EXIT

curl -fsSL "${SOUND_URL}" -o "${SOUND_FILE}" || {
    echo "Failed to download notification sound"
    exit 1
}

printf '\nWaiting for HTTP 200 from %s ...\n\n' "${URL}"

while true; do
    resp_code=$(curl -sS -o /dev/null -w '%{http_code}' "${URL}")

    if [ "${resp_code}" = "200" ]; then
        printf '\n🎉🎉🎉 HTTP 200 — %s IS UP! 🎉🎉🎉\n' "${URL}"
        printf '         🕐 %s UTC\n\n' "$(date -u '+%Y-%m-%d %H:%M:%S')"
        end_time=$((SECONDS + CELEBRATION_SECONDS))
        while [ "${SECONDS}" -lt "${end_time}" ]; do
            pw-play "${SOUND_FILE}" &
            PLAY_PID=$!
            while kill -0 "${PLAY_PID}" 2>/dev/null && \
                  [ "${SECONDS}" -lt "${end_time}" ]; do
                sleep 0.2
            done
            kill "${PLAY_PID}" 2>/dev/null || true
            PLAY_PID=""
        done
        exit 0
    fi
    printf "💀 HTTP %s — retrying in %ss...\n" "${resp_code}" "${POLL_INTERVAL}"
    sleep "${POLL_INTERVAL}"
done
