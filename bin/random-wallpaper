#!/usr/bin/env bash
#
# Copyright (c) Corey Goldberg (https://github.com/cgoldberg)
#
# set a random GNOME wallpaper from a directory without repeating the current image


set -euo pipefail


WALLPAPER_DIR="${HOME}/Wallpapers"

if {
    ! type gsettings >/dev/null 2>&1 ||
    ! type gdk-pixbuf-thumbnailer >/dev/null 2>&1 ||
    [[ ":${XDG_CURRENT_DESKTOP:-}:" != *:GNOME:* ]]
}; then
    echo "this script requires GNOME" >&2
    exit 1
fi

if [ ! -d "${WALLPAPER_DIR}" ]; then
    echo "${WALLPAPER_DIR} not found" >&2
    exit 1
fi

current="$(gsettings get org.gnome.desktop.background picture-uri)"
current="${current#\'file://}"
current="${current%\'}"

mapfile -d '' files < <(find "${WALLPAPER_DIR}" -type f -print0)

choices=()
for file in "${files[@]}"; do
    case "${file,,}" in
        *.jpg|*.jpeg|*.png|*.webp)
            ;;
        *)
            continue
            ;;
    esac
    if [ "${file}" != "${current}" ]; then
        choices+=("${file}")
    fi
done

if (( ${#choices[@]} == 0 )); then
    wallpaper="${current}"
else
    wallpaper="${choices[RANDOM % ${#choices[@]}]}"
fi

gsettings set org.gnome.desktop.background picture-uri "file://${wallpaper}"
gsettings set org.gnome.desktop.background picture-uri-dark "file://${wallpaper}"

echo "switched wallpaper to: ${wallpaper}"
