#!/usr/bin/env bash
#
# Copyright (c) Corey Goldberg (https://github.com/cgoldberg)
#
# NAS sync script:
#  - mounts remote NAS filesystem with CIFS/SMB if needed
#  - syncs local filesystem
#  - syncs remote filesystem via ssh
#
# requires:
#  - key-based ssh login configured between host and NAS
#
# note:
#  - connect with ssh once to accept host keys before running this
#    for the first time or it will fail silently


ALLOWED_HOSTS=("minime" "raspberrypi")

# 2-bay QNAP
NAS_HOST="bitz"
NAS_IP="10.0.0.5"
NAS_MNT="/mnt/${NAS_HOST}"

SEP="----------------------------------------------------------------"
BOLD="\e[1m"
GREEN="\e[32m"
RED="\e[31m"
RESET="\e[0m"


err() {
    printf '%b✗%b %s\n' "${RED}" "${RESET}" "$*" >&2
}

ok() {
    printf '%b✓%b %s\n' "${GREEN}" "${RESET}" "$*" >&2
}

die() {
    err "$*"
    exit 1
}

check_host() {
    local can_run="false"
    for i in {0..1}; do
        local host="${ALLOWED_HOSTS[${i}]}"
        if [ "${HOSTNAME}" == "${host}" ]; then
            can_run="true"
        fi
    done
    if [ "${can_run}" == "false" ] ; then
        die "fatal: can't run on this host: ${HOSTNAME}"
    fi
}

check_host
echo
mount-bitz
echo
echo "syncing filesystem..."
sync
ssh "admin@${NAS_IP}" "sync"
echo
ok "sync complete"
